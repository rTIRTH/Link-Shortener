# Copy to .env for local development (never commit the real .env)
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./link_shortener.db
# REDIS_URL=redis://localhost:6379/0
# BASE_URL=https://your-app.onrender.com
# HTTPS_ONLY=true
# ADMIN_USERNAMES=your_username   # who can open /admin (comma-separated)

# --- Email for the "change email" verification code (optional) ---
# Render's free tier blocks SMTP, so we use Brevo's web API instead.
# BREVO_API_KEY=your-brevo-api-key
# MAIL_FROM=the-sender-address-you-verified-in-brevo@example.com
# MAIL_FROM_NAME=Link Shortener
# EMAIL_BACKEND=console   # development only: prints the code in the server log
