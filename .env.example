# Copy to .env for local development (never commit the real .env)
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./link_shortener.db
# REDIS_URL=redis://localhost:6379/0
# BASE_URL=https://your-app.onrender.com
# HTTPS_ONLY=true
# ADMIN_USERNAMES=your_username   # who can open /admin (comma-separated)

# --- Email for the "change email" verification code (optional) ---
# Render's free tier blocks SMTP, so we use Brevo's web API instead.
# BREVO_API_KEY=your-brevo-api-key
# MAIL_FROM=the-sender-address-you-verified-in-brevo@example.com
# MAIL_FROM_NAME=Link Shortener
# EMAIL_BACKEND=console   # development only: prints the code in the server log

# --- Sign-up email check ---
# With email set up (BREVO_API_KEY + MAIL_FROM above), new accounts must enter an emailed code.
# Without it, sign-up works as before. Most sign-up code emails sent per day (Brevo free: ~300):
# SIGNUP_CODES_PER_DAY=200

# --- Forgot password ---
# Needs the email setup above. The emailed link uses BASE_URL (or, on Render, the service's own
# address). Most reset emails sent per day:
# RESET_EMAILS_PER_DAY=50

# --- Email alerts for links (needs the email setup above) ---
# Most alert emails per day, in all and for one person:
# ALERT_EMAILS_PER_DAY=100
# ALERT_EMAILS_PER_USER=10
# "About a day before a link ends" alerts are looked for after clicks and dashboard visits. To be
# sure they go out even on quiet days, let a free cron service (e.g. cron-job.org) open
#   https://your-app.onrender.com/run-alerts?key=THE_SECRET   once an hour. Choose any long secret:
# CRON_SECRET=

# --- Database ---
# Local: leave DATABASE_URL out and a SQLite file is used. Online (Render): use a permanent free
# Postgres such as Neon and paste its address, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
